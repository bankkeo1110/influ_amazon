generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model ProductSearch {
  id          String         @id @default(cuid())
  productName String
  createdAt   DateTime       @default(now())
  videos      YoutubeVideo[]
}

model YoutubeVideo {
  id              String        @id @default(cuid())
  videoId         String
  title           String
  description     String        @db.Text
  thumbnailUrl    String
  channelTitle    String
  publishedAt     String
  viewCount       String?
  hasAffiliate    Boolean       @default(false)
  productSearchId String
  productSearch   ProductSearch @relation(fields: [productSearchId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
}

// ─── Channel Finder ──────────────────────────────────────────────────────────

model ChannelQuery {
  id        String    @id @default(cuid())
  query     String
  status    String    @default("pending") // pending | done | error
  error     String?   @db.Text
  createdAt DateTime  @default(now())
  channels  Channel[]
}

model Channel {
  id             String       @id @default(cuid())
  name           String
  handle         String?
  url            String
  thumbnailUrl   String?
  subscriberText String?
  avgLengthSec   Int?
  description    String?      @db.Text
  channelQueryId String
  channelQuery   ChannelQuery @relation(fields: [channelQueryId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
}

// ─── Facebook Page Manager ───────────────────────────────────────────────────

model User {
  id          String         @id @default(cuid())
  facebookId  String         @unique
  name        String?
  email       String?
  accessToken String         // AES-256-GCM encrypted long-lived user token
  tokenExpiry DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  pages       FacebookPage[]
}

model FacebookPage {
  id          String             @id @default(cuid())
  pageId      String             @unique
  name        String
  category    String?
  accessToken String             // AES-256-GCM encrypted long-lived page token
  isActive    Boolean            @default(true)
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts       FacebookPost[]
  queueItems  ContentQueueItem[]
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
}

model FacebookPost {
  id                String       @id @default(cuid())
  fbPostId          String?      // ID returned by Graph API after creation
  pageId            String
  page              FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  message           String       @db.Text
  imageUrl          String?
  link              String?
  status            String       // 'published' | 'scheduled' | 'cancelled' | 'failed'
  scheduledTime     DateTime?
  isRecurring       Boolean      @default(false)
  recurringSeriesId String?
  errorMessage      String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model ContentQueueItem {
  id        String       @id @default(cuid())
  pageId    String
  page      FacebookPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  message   String       @db.Text
  imageUrl  String?
  link      String?
  sortOrder Int          @default(0)
  consumed  Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

// ─── Amazon Influencer Storefronts ───────────────────────────────────────────

model AmazonShop {
  id            String   @id @default(cuid())
  handle        String   @unique // vanity handle from /shop/<handle>
  url           String
  name          String
  videoCount    Int      @default(0)
  countCapped   Boolean  @default(false) // true when the video walk hit maxVideoPages
  sourceQuery   String?
  asinsMined    Boolean  @default(false) // product ASINs already pulled from this storefront
  lastCrawledAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([videoCount])
  @@index([name])
}

model ShopCrawlJob {
  id           String    @id @default(cuid())
  baseQuery    String
  target       Int
  status       String    @default("running") // running | done | stopped | error
  discovered   Int       @default(0) // unique handles seen across all query variants
  saved        Int       @default(0) // rows written to AmazonShop
  queriesRun   Int       @default(0)
  cycles       Int       @default(0) // cool-off/resume rounds survived
  phase        String    @default("crawling") // crawling | cooling
  resumeAt     DateTime? // when a cooling job wakes up again
  currentQuery String?
  note         String?   @db.Text // last provider/throttle message, shown live in the UI
  error        String?   @db.Text
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?
  updatedAt    DateTime  @updatedAt
}

/** Single-row settings for the Shop crawler (id is always "default"). */
model CrawlSetting {
  id        String   @id @default("default")
  proxies   String   @default("") @db.Text // one proxy URL per line, tried in order
  updatedAt DateTime @updatedAt
}

// ─── Amazon Profile Manager ──────────────────────────────────────────────────

model AmazonProfile {
  id        String   @id @default(cuid())
  mail      String
  ip        String   @default("")
  shopUrl   String   @default("")
  status    String   @default("Step 1") // Step 1 | Submitted L1 | Submitted L2 | Submitted L3 | Rejected | Approved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
